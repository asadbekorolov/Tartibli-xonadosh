# Telegram Bot Configuration
BOT_TOKEN=your_token_here
BOT_NAME=TartibliXonadoshBot

# Database Configuration (PostgreSQL 16 with asyncpg)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=tartibli_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/tartibli_db

# Redis Configuration (Aiogram FSM Storage & Task Queue)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Application Timezone & Environment Settings
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
DEBUG=False
MAX_MEMBERS_PER_FLAT=10
